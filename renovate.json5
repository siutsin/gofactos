{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  packageRules: [
    {
      description: 'Keep Lua below 5.5 while Luacheck requires Lua 5.4',
      matchManagers: ['mise'],
      matchDepNames: ['lua'],
      allowedVersions: '<5.5',
    },
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '7 days',
  rebaseWhen: 'behind-base-branch',
}
